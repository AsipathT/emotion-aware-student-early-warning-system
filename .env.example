# ──────────────────────────────────────────────
# PostgreSQL
# ──────────────────────────────────────────────
POSTGRES_USER=lms_user
POSTGRES_PASSWORD=changeme_strong_password
POSTGRES_DB=lms_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ──────────────────────────────────────────────
# SQLAlchemy (assembled by config.py)
# ──────────────────────────────────────────────
# Leave blank – config.py builds this from the fields above.
# DATABASE_URL=postgresql+asyncpg://lms_user:changeme_strong_password@db:5432/lms_db

# ──────────────────────────────────────────────
# FastAPI / Uvicorn
# ──────────────────────────────────────────────
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
SECRET_KEY=replace_with_a_long_random_secret_key_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_ENV=development
DEBUG=true

# ──────────────────────────────────────────────
# Feature 21 & 23: Component API Keys (JSON mapping scope -> key)
# ──────────────────────────────────────────────
COMPONENT_API_KEYS={"c1": "c1_dev_secret_key_change_in_production", "c2": "c2_dev_secret_key_change_in_production", "c3": "c3_dev_secret_key_change_in_production", "c4": "c4_dev_secret_key_change_in_production"}

# ──────────────────────────────────────────────
# Feature 22: Weekly Scheduler & Pipeline Orchestrator
# ──────────────────────────────────────────────
SCHEDULER_ENABLED=false
SCHEDULER_TICK_MINUTES=15
SCHEDULER_GRACE_HOURS=1
SCHEDULER_LOOKBACK_WEEKS=2
SCHEDULER_MAX_WEEKS_PER_TICK=20
SCHEDULER_EXCLUDED_COURSE_SOURCES=oulad,demo
PIPELINE_COVERAGE_THRESHOLD=0.9
PIPELINE_STAGE_TIMEOUT_HOURS=24
PIPELINE_C4_MIN_TIER=medium
# Optional JSON mapping: {"c1": "https://...", "c2": "https://..."}
COMPONENT_WEBHOOKS=
WEBHOOK_SIGNING_SECRET=webhook_secret_key_change_in_production
WEBHOOK_TIMEOUT_SECONDS=5.0
WEBHOOK_MAX_RETRIES=3


