# Copy this file to .env and fill in the values.

# OpenAI key for the AI-generated explanations (https://platform.openai.com/api-keys).
# Leave empty to run without explanations; everything else still works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Secret used to sign login tokens. Use any long random string.
# If empty, a random one is made at start-up and everyone is logged out on restart.
JWT_SECRET=
JWT_EXPIRE_HOURS=8

# Frontend address(es) allowed to call the API, comma separated.
CORS_ORIGINS=http://localhost:5173
